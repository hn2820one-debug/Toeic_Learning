generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum FsrsState {
  New
  Learning
  Review
  Relearning
}

enum FsrsRating {
  Again
  Hard
  Good
  Easy
}

enum UserRole {
  LEARNER
  ADMIN
}

// ─────────────────────────────────────────────
//  USERS & ACCESS (multi-tenant foundation — no OAuth in this repo yet)
// ─────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  /// Short handle; prefer UserProfile.displayName when set.
  name      String   @default("Keith")
  /// Nullable until the learner links an email (hosted / auth phase).
  email     String?  @unique
  /// Reserved for future SSO (e.g. google, supabase). Not wired to any SDK in this repo.
  externalAuthProvider String?
  /// External subject id from the provider; use with externalAuthProvider.
  externalUserId       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       UserProfile?
  enrollments   Enrollment[]
  preferences   UserPreference[]
  studySessions StudySession[]

  @@unique([externalAuthProvider, externalUserId])
  @@map("users")
}

/// Slow-changing learner-facing fields (display, goals, role). One row per user.
model UserProfile {
  id          String   @id @default(cuid())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String?
  /// IANA timezone id, e.g. Asia/Taipei
  timezone    String?
  /// Target TOEIC score or similar goal (optional).
  targetScore Int?
  role        UserRole @default(LEARNER)
  updatedAt   DateTime @updatedAt

  @@map("user_profiles")
}

/// Program enrollment (programKey aligns with file-based curriculum, e.g. phase1).
model Enrollment {
  id          String   @id @default(cuid())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programKey  String
  status      String   @default("active")
  enrolledAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, programKey])
  @@index([programKey])
  @@map("enrollments")
}

/// Key/value preferences (value often JSON) — optional extension point.
model UserPreference {
  id        String   @id @default(cuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@map("user_preferences")
}

// ─────────────────────────────────────────────
//  LEARNING ITEMS
//  Core knowledge atoms: word / phrase / false_friend
// ─────────────────────────────────────────────
model LearningItem {
  id             Int      @id @default(autoincrement())
  itemType       String   // word | phrase | false_friend
  term           String
  meaning        String?
  confusionWord  String?  // false_friend: the word it gets confused with
  confusionMeaning String? // false_friend: confusion word's meaning
  exampleEn      String?
  exampleZh      String?
  topic          String?
  level          String?  // A | B | C
  source         String?  // e.g. "checkpoint-1-100"
  originalResult String?  // 會 | 不會 — initial baseline only
  isValid        Boolean  @default(true)

  // Dynamic mastery (replaces original result as truth)
  masteryScore    Float   @default(0.0)
  reviewCount     Int     @default(0)
  consecutiveOk   Int     @default(0)
  nextReview      DateTime?
  intervalDays    Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questionItems QuestionItem[]
  reviewQueues  ReviewQueue[]

  @@map("learning_items")
}

// ─────────────────────────────────────────────
//  QUESTION ITEMS
//  Answerable questions shown in browser UI
// ─────────────────────────────────────────────
model QuestionItem {
  id             Int           @id @default(autoincrement())
  learningItemId Int?
  learningItem   LearningItem? @relation(fields: [learningItemId], references: [id])

  questionType   String  // vocab|phrase|false_friend|part5|part6|part7|part2|part3|part4
  promptText     String
  optionA        String?
  optionB        String?
  optionC        String?
  optionD        String?
  correctAnswer  String  // A | B | C | D | text
  explanation    String?
  topic          String?
  level          String?  // A | B | C
  isActive       Boolean @default(true)
  source         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionAnswers SessionAnswer[]
  reviewQueues   ReviewQueue[]

  @@map("question_items")
}

model QuestionBankItem {
  id            Int      @id @default(autoincrement())
  questionText  String   @unique
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  notes         String?
  /// Canonical Phase1 skill id (e.g. vocabulary.document-workflow). See docs/taxonomy-fields.md
  skillKey      String?
  /// Canonical Phase1 topic bucket (e.g. office). Distinct from display `topic` until backfill.
  topicKey      String?
  /// Target module id when aligned to curriculum (e.g. phase1-document-workflow).
  moduleKey     String?
  /// Provenance: seed | import_json | import_csv | manual | llm | reviewed | unknown
  sourceQuality String?
  /// Cold-start / seeding: user-known vs unknown; also used by FSRS seed scripts.
  priorKnown    Boolean?
  topic         String
  difficulty    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  answerHistory AnswerHistory[]
  fsrsCardState FsrsCardState?
  reviewLogs    ReviewLog[]
  studySessionItems StudySessionQuestion[]

  @@index([topic])
  @@index([difficulty])
  @@map("questions")
}

model FsrsCardState {
  id            String           @id @default(cuid())
  questionId    Int              @unique
  question      QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)
  due           DateTime
  stability     Float            @default(0)
  difficulty    Float            @default(0)
  elapsedDays   Float            @default(0)
  scheduledDays Float            @default(0)
  reps          Int              @default(0)
  lapses        Int              @default(0)
  state         FsrsState        @default(New)
  lastReview    DateTime?
  seededFrom    String?
  suspended     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([state, due])
  @@index([state, createdAt])
  @@map("fsrs_card_state")
}

model ReviewLog {
  id              String           @id @default(cuid())
  questionId      Int
  question        QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rating          FsrsRating
  state           FsrsState
  due             DateTime
  stability       Float
  difficulty      Float
  elapsedDays     Float
  lastElapsedDays Float
  scheduledDays   Float
  review          DateTime

  @@index([review])
  @@index([questionId, review])
  @@map("review_log")
}

model FsrsParams {
  id               String   @id @default("singleton")
  w                String
  requestRetention Float    @default(0.9)
  updatedAt        DateTime @updatedAt

  @@map("fsrs_params")
}

model LlmUsageLog {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  taskType         String
  provider         String
  model            String
  promptVersion    String
  promptTokens     Int
  completionTokens Int
  cachedTokens     Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costUsd          Float
  latencyMs        Int
  success          Boolean
  errorMessage     String?
  sessionId        String?
  questionId       String?
  temperature      Float?
  seed             Int?

  @@index([createdAt])
  @@index([taskType, createdAt])
  @@map("llm_usage_log")
}

model EloState {
  id        String   @id @default(cuid())
  kind      String
  subjectId String
  rating    Float    @default(1500)
  n         Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([kind, subjectId])
  @@index([kind])
  @@map("elo_state")
}

model TopicMastery {
  topic     String   @id
  flag      String   @default("Mixed")
  attempts  Int      @default(0)
  correct   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("topic_mastery")
}

model StudySession {
  id             Int      @id @default(autoincrement())
  /// Set when the runtime knows the acting user (dev bootstrap or future auth). Legacy rows may be null.
  userId         Int?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  startedAt      DateTime
  endedAt        DateTime?
  abandonedAt    DateTime?
  totalQuestions Int      @default(0)
  correctCount   Int      @default(0)
  mode           String   @default("quick")
  targetCount    Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  answerHistory AnswerHistory[]
  items         StudySessionQuestion[]

  @@index([userId])
  @@map("study_sessions")
}

model StudySessionQuestion {
  id           String           @id @default(cuid())
  sessionId    Int
  session      StudySession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId   Int
  question     QuestionBankItem @relation(fields: [questionId], references: [id])
  position     Int
  shownAt      DateTime?
  answeredAt   DateTime?
  rating       String?
  correct      Boolean?
  timeTakenSec Int?
  userChoice   String?

  @@unique([sessionId, position])
  @@index([sessionId, answeredAt])
  @@map("study_session_question")
}

model AnswerHistory {
  id             Int              @id @default(autoincrement())
  sessionId      Int
  session        StudySession     @relation(fields: [sessionId], references: [id])
  questionId     Int
  question       QuestionBankItem @relation(fields: [questionId], references: [id])
  selectedAnswer String
  isCorrect      Boolean
  answeredAt     DateTime         @default(now())
  stemSnapshot          String   @default("")
  choicesSnapshot       String   @default("{}")
  correctAnswerSnapshot String   @default("")
  topicSnapshot         String   @default("")
  difficultySnapshot    String   @default("")

  @@index([sessionId])
  @@index([questionId])
  @@unique([sessionId, questionId])
  @@map("answer_history")
}

// ─────────────────────────────────────────────
//  LISTENING SETS & QUESTIONS (legacy — ship data only until V2 UI)
// ─────────────────────────────────────────────
model ListeningSetLegacy {
  id         Int      @id @default(autoincrement())
  title      String
  sourceUrl  String?
  part       Int      // 2 | 3 | 4
  transcript String?
  note       String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  questions ListeningQuestionLegacy[]

  @@map("listening_sets")
}

model ListeningQuestionLegacy {
  id            Int                @id @default(autoincrement())
  setId         Int
  set           ListeningSetLegacy @relation(fields: [setId], references: [id])
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  orderNo       Int                @default(0)

  @@map("listening_questions")
}

// ─────────────────────────────────────────────
//  LISTENING V2 (stub — future implementation)
// ─────────────────────────────────────────────
model ListeningSetV2 {
  id         String   @id @default(cuid())
  part       Int // 1 | 2 | 3 | 4
  audioUrl   String
  transcript String
  topic      String?
  createdAt  DateTime @default(now())

  questions ListeningQuestionV2[]

  @@map("listening_set_v2")
}

model ListeningQuestionV2 {
  id             String         @id @default(cuid())
  setId          String
  set            ListeningSetV2 @relation(fields: [setId], references: [id], onDelete: Cascade)
  stem           String
  choices        String // JSON: {A,B,C,D}
  answer         String
  timestampStart Int? // seconds into audio

  @@index([setId])
  @@map("listening_question_v2")
}

// ─────────────────────────────────────────────
//  DAILY SESSIONS
// ─────────────────────────────────────────────
model DailySession {
  id             Int      @id @default(autoincrement())
  sessionDate    DateTime // date only (stored as datetime, compare by date)
  dayType        Int      // 1 | 2 | 3 | 4
  status         String   @default("pending") // pending | in_progress | completed
  totalQuestions Int      @default(0)
  correctCount   Int      @default(0)
  durationMin    Int      @default(45)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  answers SessionAnswer[]

  @@map("daily_sessions")
}

// ─────────────────────────────────────────────
//  SESSION ANSWERS
// ─────────────────────────────────────────────
model SessionAnswer {
  id             Int          @id @default(autoincrement())
  sessionId      Int
  session        DailySession @relation(fields: [sessionId], references: [id])
  questionItemId Int
  questionItem   QuestionItem @relation(fields: [questionItemId], references: [id])
  userAnswer     String?
  isCorrect      Boolean
  errorType      String?      // V|FF|G|S|C|LK|IN|DS|SP|VN
  timeSpentSec   Int?
  createdAt      DateTime     @default(now())

  @@map("session_answers")
}

// ─────────────────────────────────────────────
//  REVIEW QUEUE
// ─────────────────────────────────────────────
model ReviewQueue {
  id             Int           @id @default(autoincrement())
  learningItemId Int
  learningItem   LearningItem  @relation(fields: [learningItemId], references: [id])
  questionItemId Int?
  questionItem   QuestionItem? @relation(fields: [questionItemId], references: [id])
  nextReviewDate DateTime
  intervalDays   Int           @default(1)
  easeFactor     Float         @default(2.5)
  wrongCount     Int           @default(0)
  lastResult     String?       // correct | wrong
  active         Boolean       @default(true)
  updatedAt      DateTime      @updatedAt

  @@map("review_queue")
}

// ─────────────────────────────────────────────
//  TOPIC WEIGHTS
// ─────────────────────────────────────────────
model TopicWeight {
  id            Int      @id @default(autoincrement())
  topic         String   @unique
  baseWeight    Float    @default(1.0)
  currentWeight Float    @default(1.0)
  updatedAt     DateTime @updatedAt
  reason        String?

  @@map("topic_weights")
}

// ─────────────────────────────────────────────
//  WEEKLY REPORTS
// ─────────────────────────────────────────────
model WeeklyReport {
  id                Int      @id @default(autoincrement())
  weekNo            Int      @unique
  weekStart         DateTime
  weekEnd           DateTime
  totalQuestions    Int      @default(0)
  totalAccuracy     Float?
  readingAccuracy   Float?
  listeningAccuracy Float?
  weakestTopics     String?  // JSON array string
  weakestErrorTypes String?  // JSON array string
  nextWeekFocus     String?
  programPhase      Int      @default(1)
  createdAt         DateTime @default(now())

  @@map("weekly_reports")
}

// ─────────────────────────────────────────────
//  SCORE HISTORY
// ─────────────────────────────────────────────
model ScoreHistory {
  id        Int      @id @default(autoincrement())
  date      DateTime
  testType  String   @default("mock") // official | mock
  listening Int
  reading   Int
  total     Int
  note      String?
  createdAt DateTime @default(now())

  @@map("score_history")
}
