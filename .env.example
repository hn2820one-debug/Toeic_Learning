# Required for Prisma CLI + app runtime (SQLite, local-first)
DATABASE_URL="file:./dev.db"

# Optional: export API guard; if empty, localhost-only export access
EXPORT_API_SECRET=""

# Optional: local debug toggles
ALLOW_DEV_USER_BOOTSTRAP="1"
ALLOW_LEARN_DEBUG="0"

# Optional: LLM providers
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional: LLM gateway model controls
LLM_PROVIDER_ORDER="google,anthropic,openai"
LLM_GATEWAY_GEMINI_MODEL="gemini-2.5-flash"
LLM_GATEWAY_ANTHROPIC_MODEL="claude-haiku-4-5"
LLM_GATEWAY_OPENAI_MODEL="gpt-4o-mini"

# Optional: app URL hint for links/docs (currently not required by code)
APP_BASE_URL="http://127.0.0.1:5173"

